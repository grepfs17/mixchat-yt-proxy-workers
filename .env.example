# MixChat YouTube Proxy Workers — Environment Variables

# ── Auth ──
# Required. Shared secret token that MixChat sends as Authorization: Bearer <token>.
# Set via: wrangler secret put AUTH_TOKEN
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_TOKEN=

# ── Security ──
# Required. Allowed origin for CORS. Set to your MixChat URL.
# Set via: wrangler secret put CORS_ORIGIN (if secret) or in wrangler.toml [vars]
# CORS_ORIGIN=https://your-mixchat-url.example

# ── YouTube InnerTube ──
YT_CLIENT=WEB
YT_DEBUG=0

# Optional — override the default Chrome User-Agent
# YT_USER_AGENT=

# Optional — browser cookie string for authenticated access (strongest anti-403)
# Set via: wrangler secret put YT_COOKIE
# YT_COOKIE=

# Manual PoToken and visitor_data
# Set via: wrangler secret put YT_POTOKEN  /  wrangler secret put YT_VISITOR_DATA
# YT_POTOKEN=
# YT_VISITOR_DATA=

# ── Rate limiting ──
YT_RATE_LIMIT_MAX=200